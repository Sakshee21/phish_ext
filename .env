# Show the warning-condition picker in every build (dev, pilot, and the
# production/store artifact), so all five warning designs are selectable.
#
# Mechanism: condition-assignment.ts gates the picker on
#   DEV_MODE = import.meta.env.DEV || import.meta.env.WXT_DEV_PICKER === 'true'
# Vite loads this file in every mode, so the flag reaches all builds. Delete
# this line (or set it to false) to strip the picker from the build again --
# random assignment itself is unaffected either way.
WXT_DEV_PICKER=true
