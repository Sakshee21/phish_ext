# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.output
stats.html
stats-*.json
.wxt
web-ext.config.ts
stuff/
.agents/
.claude/

# Private half of the pinned extension key (public half is in wxt.config.ts).
dev-key.pem

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

CLAUDE.md

# Real screenshots for manual pHash testing (scripts/test-phash.ts) — often
# real third-party brand pages, not something to commit. Keep the folder
# and its README, ignore the images themselves.
test-images/*
!test-images/README.md

# Screenshots captured by the Python dataset generator (tools/generate.py) —
# real third-party brand pages. Keep the folder, ignore the images.
tools/captures/*

# Python virtualenv for the dataset generator.
tools/.venv/

# Windows alternate-data-stream metadata, created when a file is downloaded
# and then read through the WSL bridge. Not real files.
*:Zone.Identifier
*Zone.Identifier

# Local study clones (test-pages/*.html) — brand-impersonation markup fetched
# from the collaborator's GitHub Pages, not something to commit. Keep the folder,
# the hostname map, and the README; repopulate the HTML with scripts/fetch-clones.sh.
test-pages/*.html
!test-pages/clone-map.tsv
!test-pages/README.md
