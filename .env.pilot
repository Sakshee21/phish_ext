# Pilot/testing build: production output, but with the dev condition picker.
#
#   pnpm build:pilot   -> picker visible  (testing, NOT for participants)
#   pnpm build         -> picker stripped (the study build)
#
# Vite only exposes variables from .env files, not from the shell, and only
# ones carrying a WXT_/VITE_ prefix. This file is loaded solely by --mode pilot,
# so a plain `pnpm build` cannot pick it up by accident.
WXT_DEV_PICKER=true
